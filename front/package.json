    "@vitejs/plugin-react": "^5.1.2",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.2",
    "eslint-plugin-perfectionist": "^5.4.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "plop": "^4.0.5",
    "prettier": "^3.8.1",
