    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-devtools": "0.2.2",
    "@tanstack/react-router": "^1.154.10",
    "@tanstack/react-router-devtools": "^1.154.10",
    "@tanstack/router-plugin": "^1.154.10",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "jotai": "^2.16.2",
    "pixi.js": "^8.15.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
